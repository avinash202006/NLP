      "source": [
        "# DFA Simulator\n",
        "\n",
        "# DFA Description\n",
        "states = {\"q0\", \"q1\", \"q2\"}\n",
        "alphabet = {\"a\", \"b\"}\n",
        "\n",
        "# Transition Table\n",
        "transition = {\n",
        "    (\"q0\", \"a\"): \"q1\",\n",
        "    (\"q0\", \"b\"): \"q0\",\n",
        "    (\"q1\", \"a\"): \"q1\",\n",
        "    (\"q1\", \"b\"): \"q2\",\n",
        "    (\"q2\", \"a\"): \"q1\",\n",
        "    (\"q2\", \"b\"): \"q0\"\n",
        "}\n",
        "\n",
        "initial_state = \"q0\"\n",
        "final_states = {\"q2\"}\n",
        "\n",
        "# Number of test strings\n",
        "n = int(input(\"Enter number of strings: \"))\n",
        "\n",
        "for _ in range(n):\n",
        "    string = input(\"Enter string: \")\n",
        "\n",
        "    current_state = initial_state\n",
        "    path = [current_state]\n",
        "    valid = True\n",
        "\n",
        "    for symbol in string:\n",
        "        if symbol not in alphabet:\n",
        "            valid = False\n",
        "            break\n",
        "\n",
        "        current_state = transition[(current_state, symbol)]\n",
        "        path.append(current_state)\n",
        "\n",
        "    if not valid:\n",
        "        print(\"Invalid Input\")\n",
        "    else:\n",
        "        print(\"Transition Path:\")\n",
        "        print(\" → \".join(path))\n",
        "\n",
        "        if current_state in final_states:\n",
        "            print(\"Accepted\")\n",
        "        else:\n",
        "            print(\"Rejected\")\n",
        "\n",
        "    print()"
      ]
    }
